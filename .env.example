# SumVideo 环境（与 config/environments.json 对应）
# 本地 Web / Electron 开发：
SUMVIDEO_ENV=dev

# 已安装桌面应用由 Electron 自动使用 desktop 配置（8001），一般无需手动设置
# SUMVIDEO_ENV=desktop

# 可选：覆盖 config 中的端口（调试用）
# SUMVIDEO_BACKEND_PORT=8000
# SUMVIDEO_BACKEND_URL=http://127.0.0.1:8000
# SUMVIDEO_FRONTEND_PORT=5173

# 后端热重载（处理视频时不要开）
# SUMVIDEO_RELOAD=1

# Electron 开发（连接 Vite + 复用 dev 后端）
# SUMVIDEO_DEV=1
